{
  "openapi": "3.1.0",
  "info": {
    "title": "Porta de integração do Regem",
    "version": "1.0.0",
    "description": "A API que os aplicativos ligados à loja chamam: as vendas, os clientes, os cupons, o catálogo, as fichas e a fila de produção, com o que a loja autorizou. Credencial: o token do DMS ID com o segredo da ligação (DMS-Ligacao).",
    "x-dms-produto": "regem",
    "x-dms-pacote": "0.9.0"
  },
  "servers": [
    {
      "url": "https://api.dmsregem.com"
    }
  ],
  "security": [
    {
      "dmsId": []
    }
  ],
  "paths": {
    "/api/v1/integracao/loja": {
      "get": {
        "operationId": "get_api_v1_integracao_loja",
        "summary": "Loja do token: nome, fuso, moeda, escopos concedidos e o cardápio online.",
        "x-dms-permissao": null,
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "example": {
                  "loja_id": "1f0c2a3b-0000-4000-8000-000000000001",
                  "loja_nome": "Centro",
                  "empresa_nome": "Hamburgueria Exemplo",
                  "fuso": "America/Sao_Paulo",
                  "moeda": "BRL",
                  "escopos": [
                    "pedidos.ler",
                    "cupons.ler"
                  ],
                  "cardapio_url": null
                }
              }
            }
          },
          "default": {
            "description": "Erro no formato do Padrão (§7)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/integracao/autorizacao/revogar": {
      "post": {
        "operationId": "post_api_v1_integracao_autorizacao_revogar",
        "summary": "Revoga a própria credencial. Idempotente por natureza: a chamada seguinte já volta 401.",
        "x-dms-permissao": null,
        "x-dms-escrita": "substituicao",
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "example": {
                  "revogado": true,
                  "revogado_em": "2026-10-23T12:00:00.000Z"
                }
              }
            }
          },
          "default": {
            "description": "Erro no formato do Padrão (§7)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/integracao/webhook": {
      "put": {
        "operationId": "put_api_v1_integracao_webhook",
        "summary": "Registra (ou troca) o endereço e o segredo do aviso desta credencial. Registrar de novo religa o que estava pausado.",
        "x-dms-permissao": null,
        "x-dms-escrita": "substituicao",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "url": "https://app.exemplo.test/avisos/regem/conexao-1",
                "segredo": "whsec_<o segredo, em base64>"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "example": {
                  "url": "https://app.exemplo.test/avisos/regem/conexao-1",
                  "registrado_em": "2026-10-23T12:00:00.000Z",
                  "pausado": false,
                  "pausado_em": null,
                  "motivo_pausa": null,
                  "ultimo_envio_em": null,
                  "ultimo_status_http": null,
                  "falhas_seguidas": 0,
                  "entregues": 0
                }
              }
            }
          },
          "default": {
            "description": "Erro no formato do Padrão (§7)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "get_api_v1_integracao_webhook",
        "summary": "Situação do aviso desta credencial (nunca o segredo). Sem registro, 404.",
        "x-dms-permissao": null,
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "example": {
                  "url": "https://app.exemplo.test/avisos/regem/conexao-1",
                  "registrado_em": "2026-10-23T12:00:00.000Z",
                  "pausado": false,
                  "pausado_em": null,
                  "motivo_pausa": null,
                  "ultimo_envio_em": null,
                  "ultimo_status_http": null,
                  "falhas_seguidas": 0,
                  "entregues": 0
                }
              }
            }
          },
          "default": {
            "description": "Erro no formato do Padrão (§7)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "delete_api_v1_integracao_webhook",
        "summary": "Para de avisar (apaga o endereço e o segredo). Sem registro, responde 204 do mesmo jeito.",
        "x-dms-permissao": null,
        "x-dms-escrita": "substituicao",
        "responses": {
          "204": {
            "description": "Sucesso, sem corpo"
          },
          "default": {
            "description": "Erro no formato do Padrão (§7)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          }
        }
      }
    },
