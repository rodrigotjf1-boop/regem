# Dependências
node_modules/

# Ambiente / segredos
.env
.env.*

# Build
dist/
build/

# Logs
*.log

# SO / editor
.DS_Store
Thumbs.db
.vscode/mcp.json
graphify-out/

# Binários portáteis do instalador edge (não versionar — baixados à parte)
backend/edge/bundle/

# Pasta distribuível gerada por edge/package.mjs (artefato de build)
regem-edge-dist/
# Pacote .zip de update do edge (artefato — sobe para o Storage, não para o git)
regem-edge-*.zip

# Saída do Inno Setup (instalador .exe gerado)
backend/edge/Output/

# Mídia gravada em disco no modo local/offline (não versionar uploads de teste)
backend/uploads/
uploads/

# Assinatura de código (rota interna): a CHAVE PRIVADA nunca vai pro git.
# Só o code-signing-ca.pem (público) é versionado; o .pfx fica só com a distribuição.
desktop/signing/
*.pfx

# Assinatura de update (Ed25519, Fase 3): a chave PRIVADA nunca vai pro git.
# Só o update-pub.pem (público) é versionado; update-priv.pem fica só com a distribuição.
backend/edge/update-priv.pem
